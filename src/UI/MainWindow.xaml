<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinSweep v4.0 - Windows System, GPU, AI &amp; Privacy Cleaner"
    Height="880" Width="1100"
    MinHeight="720" MinWidth="920"
    WindowStartupLocation="CenterScreen"
    Background="#0F172A" Foreground="#F8FAFC"
    FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="v" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,3,24,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="#182234"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="#182234" BorderBrush="#334155" BorderThickness="1,1,1,0" CornerRadius="5,5,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="Auto"/> <!-- 1: Presets & Search -->
            <RowDefinition Height="*"/>    <!-- 2: Main TabControl -->
            <RowDefinition Height="165"/>  <!-- 3: Live Console -->
            <RowDefinition Height="Auto"/> <!-- 4: Progress & Bottom Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="14,10" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WINSWEEP" FontSize="19" FontWeight="Bold" Foreground="#38BDF8"/>
                        <Border Background="#0284C7" CornerRadius="3" Margin="10,2,0,2" Padding="6,1">
                            <TextBlock Text="v4.0" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Name="lblDriveInfo" Text="Drive C:\ --" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Clean Windows logs, GPU shaders, AI runtime/brain traces, LLM blobs, and temp caches."
                               Foreground="#94A3B8" FontSize="11.5" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#1E1B4B" CornerRadius="4" Padding="10,6" BorderBrush="#4F46E5" BorderThickness="1" Margin="0,0,8,0">
                    <TextBlock Name="lblAgeBadge" Text="Age Filter: All Files" Foreground="#C7D2FE" FontWeight="SemiBold" FontSize="11.5"/>
                </Border>

                <Border Grid.Column="2" Background="#064E3B" CornerRadius="4" Padding="10,6" BorderBrush="#059669" BorderThickness="1">
                    <TextBlock Text="[SAFE] Browser Data Untouched" Foreground="#6EE7B7" FontWeight="Bold" FontSize="11.5"/>
                </Border>
            </Grid>
        </Border>

        <!-- 1. Presets & Search Bar -->
        <Border Grid.Row="1" Background="#182234" CornerRadius="5" Padding="10,7" Margin="0,0,0,10" BorderBrush="#2A384F" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="PRESETS:" FontWeight="Bold" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,0,10,0"/>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="btnPresetAll" Content="Select All" Margin="0,0,6,0" Background="#2563EB" BorderBrush="#3B82F6"/>
                    <Button Name="btnPresetNone" Content="Deselect All" Margin="0,0,6,0"/>
                    <Button Name="btnPresetRecommended" Content="Recommended (Safe)" Margin="0,0,6,0" Background="#0D9488" BorderBrush="#14B8A6"/>
                    <Button Name="btnPresetSecurityOnly" Content="Security Only" Margin="0,0,6,0" Background="#4F46E5" BorderBrush="#6366F1"/>
                    <Button Name="btnPresetGraphicsOnly" Content="Graphics &amp; Caches" Margin="0,0,6,0" Background="#D97706" BorderBrush="#F59E0B"/>
                    <Button Name="btnPresetPrivacyOnly" Content="AI &amp; Privacy" Margin="0,0,6,0" Background="#7C3AED" BorderBrush="#8B5CF6"/>
                </WrapPanel>
                <Grid Grid.Column="2" Margin="8,0,0,0">
                    <TextBox Name="txtSearch" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                             Padding="8,5" FontSize="12" VerticalContentAlignment="Center" ToolTip="Filter cleanup tasks by name or keyword"/>
                    <TextBlock Name="lblSearchPlaceholder" Text="Search tasks..." Foreground="#64748B" FontSize="12"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Main TabControl -->
        <TabControl Name="tabMain" Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,10">
            <!-- TAB 1: Cleanup Tasks -->
            <TabItem Header="Cleanup Tasks">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Name="pnlLeftColumn" Grid.Column="0" Margin="0,0,6,0"/>
                        <StackPanel Name="pnlRightColumn" Grid.Column="1" Margin="6,0,0,0"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: AI Models & Blobs -->
            <TabItem Header="AI Models &amp; Blobs">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#182234" CornerRadius="5" Padding="10,8" Margin="0,0,0,8" BorderBrush="#2A384F" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Name="btnScanModels" Content="Scan LLM Models &amp; Blobs" Background="#0284C7" BorderBrush="#38BDF8" Margin="0,0,8,0"/>
                                <Button Name="btnSelectAllModels" Content="Select All" Margin="0,0,6,0"/>
                                <Button Name="btnDeselectAllModels" Content="Deselect All" Margin="0,0,12,0"/>
                                <TextBlock Name="lblModelSummary" Text="Click 'Scan LLM Models &amp; Blobs' to inspect Ollama, Hugging Face, LM Studio, GPT4All, Jan, and custom model folders."
                                           Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Name="btnDeleteModels" Content="Delete Selected Models" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Background="#DC2626" BorderBrush="#EF4444"/>
                        </DockPanel>
                    </Border>
                    <DataGrid Name="dgModels" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="#0A0F1D" Foreground="#E2E8F0" RowBackground="#111827" AlternatingRowBackground="#182234"
                              BorderBrush="#334155" BorderThickness="1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                              HeadersVisibility="Column" SelectionMode="Extended">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Del" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" IsReadOnly="True" Width="170"/>
                            <DataGridTextColumn Header="Model / Blob Name" Binding="{Binding ModelName}" IsReadOnly="True" Width="260"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding LastModified}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding PrimaryPath}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: Settings & Automation -->
            <TabItem Header="Settings &amp; Automation">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Settings Column -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <Border Background="#1E293B" CornerRadius="6" Padding="14" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="SAFETY &amp; RETENTION" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Only delete files older than (days, 0 = all):" Foreground="#E2E8F0" Width="260" VerticalAlignment="Center"/>
                                        <TextBox Name="txtOlderThanDays" Text="0" Width="70" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,4"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Keep WinSweep logs for (days):" Foreground="#E2E8F0" Width="260" VerticalAlignment="Center"/>
                                        <TextBox Name="txtLogRetentionDays" Text="30" Width="70" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,4"/>
                                    </StackPanel>
                                    <CheckBox Name="chkRestorePoint" Content="Create Windows System Restore Point before cleanup" Margin="0,8,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Name="btnSaveSettings" Content="Save Settings (config.json)" Background="#0D9488" BorderBrush="#14B8A6" Margin="0,0,8,0"/>
                                        <Button Name="btnScheduleWeekly" Content="Register Weekly Task" Background="#4F46E5" BorderBrush="#6366F1" Margin="0,0,8,0"/>
                                        <Button Name="btnRemoveSchedule" Content="Remove Scheduled Task"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#1E293B" CornerRadius="6" Padding="14" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="EXCLUSIONS (WHITELISTED PATHS OR PATTERNS)" FontWeight="Bold" FontSize="13" Foreground="#F59E0B" Margin="0,0,0,6"/>
                                    <ListBox Name="lstExclusions" Height="110" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" Margin="0,0,0,6"/>
                                    <DockPanel>
                                        <Button Name="btnRemoveExclusion" Content="Remove" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                                        <Button Name="btnAddExclusion" Content="Add" DockPanel.Dock="Right" Margin="6,0,0,0" Background="#2563EB" BorderBrush="#3B82F6"/>
                                        <TextBox Name="txtNewExclusion" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,4"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Settings Column -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Border Background="#1E293B" CornerRadius="6" Padding="14" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CUSTOM CLEANUP FOLDERS" FontWeight="Bold" FontSize="13" Foreground="#22C55E" Margin="0,0,0,6"/>
                                    <ListBox Name="lstCustomPaths" Height="110" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" Margin="0,0,0,6"/>
                                    <DockPanel>
                                        <Button Name="btnRemoveCustomPath" Content="Remove" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                                        <Button Name="btnAddCustomPath" Content="Add" DockPanel.Dock="Right" Margin="6,0,0,0" Background="#2563EB" BorderBrush="#3B82F6"/>
                                        <TextBox Name="txtNewCustomPath" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,4"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#1E293B" CornerRadius="6" Padding="14" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CUSTOM LLM MODEL FOLDERS (ComfyUI, SD, etc.)" FontWeight="Bold" FontSize="13" Foreground="#A855F7" Margin="0,0,0,6"/>
                                    <ListBox Name="lstCustomModels" Height="110" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" Margin="0,0,0,6"/>
                                    <DockPanel>
                                        <Button Name="btnRemoveCustomModel" Content="Remove" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                                        <Button Name="btnAddCustomModel" Content="Add" DockPanel.Dock="Right" Margin="6,0,0,0" Background="#2563EB" BorderBrush="#3B82F6"/>
                                        <TextBox Name="txtNewCustomModel" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,4"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 3. Live Output Log Console -->
        <Border Grid.Row="3" Background="#0A0F1D" CornerRadius="5" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#111827" Padding="10,4" CornerRadius="5,5,0,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LIVE EXECUTION LOG" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox Name="cmbLogFilter" Width="110" FontSize="11" SelectedIndex="0" Background="#1E293B" Foreground="#E2E8F0">
                                <ComboBoxItem Content="All Logs"/>
                                <ComboBoxItem Content="OK / DONE"/>
                                <ComboBoxItem Content="DRY RUN"/>
                                <ComboBoxItem Content="ERRORS"/>
                                <ComboBoxItem Content="SKIPPED"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="btnCopySummary" Content="Copy Log" FontSize="10" Padding="8,2" Margin="0,0,6,0"/>
                            <Button Name="btnExportJson" Content="Export JSON" FontSize="10" Padding="8,2" Margin="0,0,6,0"/>
                            <Button Name="btnViewCurrentLog" Content="View Log File" FontSize="10" Padding="8,2" Margin="0,0,6,0"/>
                            <Button Name="btnOpenLogsFolder" Content="Open Logs Folder" FontSize="10" Padding="8,2" Margin="0,0,6,0"/>
                            <Button Name="btnClearLog" Content="Clear Console" FontSize="10" Padding="8,2"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBox Name="txtLog" Grid.Row="1" Background="#0A0F1D" Foreground="#A7F3D0"
                         FontFamily="Consolas" FontSize="11.5" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0" Padding="8" AcceptsReturn="True" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- 4. Bottom Action Bar & Progress -->
        <Border Grid.Row="4" Background="#1E293B" CornerRadius="6" Padding="14,10" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Name="pbProgress" Grid.Row="0" Height="6" Minimum="0" Maximum="100" Value="0"
                             Background="#0F172A" Foreground="#38BDF8" BorderThickness="0" Margin="0,0,0,8"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="lblStatus" Text="Ready. Click 'SCAN (DRY RUN)' to preview space or 'RUN SELECTED CLEANUP'."
                                   Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12.5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="Space Freed / Recoverable: " Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Name="lblFreed" Text="0.00 MB" Foreground="#4ADE80" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="  |  Operations: " Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Name="lblCleaned" Text="0" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Name="btnScan" Grid.Column="1" Content="SCAN (DRY RUN)"
                            Background="#0284C7" BorderBrush="#38BDF8" Foreground="White"
                            FontSize="12.5" FontWeight="Bold" Padding="16,9" Margin="0,0,8,0"/>

                    <Button Name="btnRun" Grid.Column="2" Content="RUN SELECTED CLEANUP"
                            Background="#16A34A" BorderBrush="#22C55E" Foreground="White"
                            FontSize="12.5" FontWeight="Bold" Padding="18,9" Margin="0,0,8,0"/>

                    <Button Name="btnCancel" Grid.Column="3" Content="Cancel" IsEnabled="False"
                            Background="#DC2626" BorderBrush="#EF4444" Foreground="White"
                            FontSize="12.5" FontWeight="Bold" Padding="14,9" Margin="0,0,8,0"/>

                    <Button Name="btnExit" Grid.Column="4" Content="Close"
                            Background="#334155" BorderBrush="#475569" Foreground="#CBD5E1"
                            FontSize="12.5" Padding="14,9"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
