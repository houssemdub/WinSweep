<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinSweep v4.0 - Windows System, GPU, AI &amp; Privacy Cleaner"
    Height="880" Width="1140"
    MinHeight="720" MinWidth="940"
    WindowStartupLocation="CenterScreen"
    Background="#0B1120" Foreground="#F8FAFC"
    FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Design System Color Tokens -->
        <SolidColorBrush x:Key="BgCanvas" Color="#0B1120"/>
        <SolidColorBrush x:Key="BgSurface" Color="#111827"/>
        <SolidColorBrush x:Key="BgCard" Color="#172033"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#1E293B"/>
        <SolidColorBrush x:Key="BgConsole" Color="#070B14"/>
        <SolidColorBrush x:Key="BorderDefault" Color="#273549"/>
        <SolidColorBrush x:Key="BorderFocus" Color="#38BDF8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#38BDF8"/>

        <!-- Slim Dark ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Name="ThumbBd" Background="#334155" CornerRadius="4" Margin="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#475569"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Vector CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Name="Box" Width="15" Height="15" CornerRadius="3.5"
                                    Background="#0B1120" BorderBrush="#475569" BorderThickness="1.5"
                                    Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Name="CheckMark" Data="M 2.5,7 L 6,10.5 L 11.5,3.5"
                                      Stroke="#0B1120" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#38BDF8"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interactive Button with Hover, Pressed, Disabled States -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Opacity" Value="0.88"/>
                                <Setter TargetName="BtnBd" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox & Items -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#172033"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#273549"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="v" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,3,24,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#172033" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Pill Tabs -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Margin="0,0,6,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#172033"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="Auto"/> <!-- 1: Presets & Search -->
            <RowDefinition Height="*"/>    <!-- 2: Main TabControl -->
            <RowDefinition Height="165"/>  <!-- 3: Live Console -->
            <RowDefinition Height="Auto"/> <!-- 4: Progress & Bottom Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Border Grid.Row="0" Background="{StaticResource BgSurface}" CornerRadius="8" Padding="16,12" Margin="0,0,0,10" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WINSWEEP" FontSize="19" FontWeight="Bold" Foreground="#38BDF8"/>
                        <Border Background="#0284C7" CornerRadius="4" Margin="10,2,0,2" Padding="7,1.5">
                            <TextBlock Text="v4.0" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Name="lblDriveInfo" Text="Drive C:\ --" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="System logs, GPU/3D shaders, AI runtime/brain traces, LLM models, and temp caches."
                               Foreground="#64748B" FontSize="11.5" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#172033" CornerRadius="5" Padding="10,6" BorderBrush="#273549" BorderThickness="1" Margin="0,0,8,0">
                    <TextBlock Name="lblSelectedCount" Text="Selected: 0 / 0" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11.5"/>
                </Border>

                <Border Grid.Column="2" Background="#1E1B4B" CornerRadius="5" Padding="10,6" BorderBrush="#4F46E5" BorderThickness="1" Margin="0,0,8,0">
                    <TextBlock Name="lblAgeBadge" Text="Age Filter: All Files" Foreground="#C7D2FE" FontWeight="SemiBold" FontSize="11.5"/>
                </Border>

                <Border Grid.Column="3" Background="#064E3B" CornerRadius="5" Padding="10,6" BorderBrush="#059669" BorderThickness="1">
                    <TextBlock Text="[SAFE] Browser Data Untouched" Foreground="#6EE7B7" FontWeight="Bold" FontSize="11.5"/>
                </Border>
            </Grid>
        </Border>

        <!-- 1. Presets & Search Bar -->
        <Border Grid.Row="1" Background="{StaticResource BgSurface}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="PRESETS" FontWeight="Bold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="2,0,12,0"/>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="btnPresetAll" Content="Select All" Margin="0,0,6,0" Background="#2563EB" BorderBrush="#3B82F6"/>
                    <Button Name="btnPresetNone" Content="Deselect All" Margin="0,0,6,0"/>
                    <Button Name="btnPresetRecommended" Content="Recommended (Safe)" Margin="0,0,6,0" Background="#0D9488" BorderBrush="#14B8A6"/>
                    <Button Name="btnPresetSecurityOnly" Content="Security Only" Margin="0,0,6,0" Background="#4F46E5" BorderBrush="#6366F1"/>
                    <Button Name="btnPresetGraphicsOnly" Content="Graphics &amp; Caches" Margin="0,0,6,0" Background="#B45309" BorderBrush="#D97706"/>
                    <Button Name="btnPresetPrivacyOnly" Content="AI &amp; Privacy" Margin="0,0,6,0" Background="#6D28D9" BorderBrush="#7C3AED"/>
                </WrapPanel>
                <Grid Grid.Column="2" Margin="8,0,0,0">
                    <TextBox Name="txtSearch" Background="#0B1120" Foreground="#F8FAFC" BorderBrush="#273549" BorderThickness="1"
                             Padding="10,5" FontSize="12" VerticalContentAlignment="Center" ToolTip="Filter cleanup tasks by name or keyword"/>
                    <TextBlock Name="lblSearchPlaceholder" Text="Search tasks..." Foreground="#64748B" FontSize="12"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Main TabControl -->
        <TabControl Name="tabMain" Grid.Row="2" Background="{StaticResource BgCanvas}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" Margin="0,0,0,10">
            <!-- TAB 1: Cleanup Tasks -->
            <TabItem Header="Cleanup Tasks">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Name="pnlLeftColumn" Grid.Column="0" Margin="0,0,6,0"/>
                        <StackPanel Name="pnlRightColumn" Grid.Column="1" Margin="6,0,0,0"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: AI Models & Blobs -->
            <TabItem Header="AI Models &amp; Blobs">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource BgSurface}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Name="btnScanModels" Content="Scan LLM Models &amp; Blobs" Background="#0284C7" BorderBrush="#38BDF8" Margin="0,0,8,0"/>
                                <Button Name="btnSelectAllModels" Content="Select All" Margin="0,0,6,0"/>
                                <Button Name="btnDeselectAllModels" Content="Deselect All" Margin="0,0,12,0"/>
                                <TextBlock Name="lblModelSummary" Text="Ready to scan Ollama, Hugging Face, LM Studio, GPT4All, Jan, and custom paths."
                                           Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Name="btnDeleteModels" Content="Delete Selected Models" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Background="#DC2626" BorderBrush="#EF4444"/>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <DataGrid Name="dgModels" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="#070B14" Foreground="#E2E8F0" RowBackground="#0F172A" AlternatingRowBackground="#172033"
                                  BorderBrush="#273549" BorderThickness="1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                                  HeadersVisibility="Column" SelectionMode="Extended">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#172033"/>
                                    <Setter Property="Foreground" Value="#38BDF8"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,7"/>
                                    <Setter Property="BorderBrush" Value="#273549"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Del" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" IsReadOnly="True" Width="175"/>
                                <DataGridTextColumn Header="Model / Blob Name" Binding="{Binding ModelName}" IsReadOnly="True" Width="260"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" IsReadOnly="True" Width="100"/>
                                <DataGridTextColumn Header="Modified" Binding="{Binding LastModified}" IsReadOnly="True" Width="100"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding PrimaryPath}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Name="pnlModelEmptyState" Background="#0B1120" BorderBrush="#273549" BorderThickness="1" CornerRadius="6" Padding="24">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="No LLM Models Scanned Yet" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                                <TextBlock Text="Click 'Scan LLM Models &amp; Blobs' above to inspect disk usage across Ollama, Hugging Face, LM Studio, GPT4All, and Jan."
                                           FontSize="12" Foreground="#64748B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: Settings & Automation -->
            <TabItem Header="Settings &amp; Automation">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Settings Column -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="SAFETY &amp; RETENTION" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Only delete files older than (days, 0 = all):" Foreground="#E2E8F0" Width="270" VerticalAlignment="Center"/>
                                        <TextBox Name="txtOlderThanDays" Text="0" Width="70" Background="#0B1120" Foreground="#F8FAFC" BorderBrush="#273549" Padding="8,4"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6">
                                        <TextBlock Text="Keep WinSweep logs for (days):" Foreground="#E2E8F0" Width="270" VerticalAlignment="Center"/>
                                        <TextBox Name="txtLogRetentionDays" Text="30" Width="70" Background="#0B1120" Foreground="#F8FAFC" BorderBrush="#273549" Padding="8,4"/>
                                    </StackPanel>
                                    <CheckBox Name="chkRestorePoint" Content="Create Windows System Restore Point before cleanup" Margin="0,10,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Name="btnSaveSettings" Content="Save Settings (config.json)" Background="#0D9488" BorderBrush="#14B8A6" Margin="0,0,8,0"/>
                                        <Button Name="btnScheduleWeekly" Content="Register Weekly Task" Background="#4F46E5" BorderBrush="#6366F1" Margin="0,0,8,0"/>
                                        <Button Name="btnRemoveSchedule" Content="Remove Scheduled Task"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="16" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="EXCLUSIONS (WHITELISTED PATHS OR PATTERNS)" FontWeight="Bold" FontSize="12.5" Foreground="#F59E0B" Margin="0,0,0,8"/>
                                    <ListBox Name="lstExclusions" Height="110" Background="#0B1120" Foreground="#E2E8F0" BorderBrush="#273549" Margin="0,0,0,8"/>
                                    <DockPanel>
                                        <Button Name="btnRemoveExclusion" Content="Remove" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                                        <Button Name="btnAddExclusion" Content="Add" DockPanel.Dock="Right" Margin="6,0,0,0" Background="#2563EB" BorderBrush="#3B82F6"/>
                                        <TextBox Name="txtNewExclusion" Background="#0B1120" Foreground="#F8FAFC" BorderBrush="#273549" Padding="8,4"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Settings Column -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CUSTOM CLEANUP FOLDERS" FontWeight="Bold" FontSize="12.5" Foreground="#22C55E" Margin="0,0,0,8"/>
                                    <ListBox Name="lstCustomPaths" Height="110" Background="#0B1120" Foreground="#E2E8F0" BorderBrush="#273549" Margin="0,0,0,8"/>
                                    <DockPanel>
                                        <Button Name="btnRemoveCustomPath" Content="Remove" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                                        <Button Name="btnAddCustomPath" Content="Add" DockPanel.Dock="Right" Margin="6,0,0,0" Background="#2563EB" BorderBrush="#3B82F6"/>
                                        <TextBox Name="txtNewCustomPath" Background="#0B1120" Foreground="#F8FAFC" BorderBrush="#273549" Padding="8,4"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="16" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CUSTOM LLM MODEL FOLDERS (ComfyUI, SD, etc.)" FontWeight="Bold" FontSize="12.5" Foreground="#A855F7" Margin="0,0,0,8"/>
                                    <ListBox Name="lstCustomModels" Height="110" Background="#0B1120" Foreground="#E2E8F0" BorderBrush="#273549" Margin="0,0,0,8"/>
                                    <DockPanel>
                                        <Button Name="btnRemoveCustomModel" Content="Remove" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                                        <Button Name="btnAddCustomModel" Content="Add" DockPanel.Dock="Right" Margin="6,0,0,0" Background="#2563EB" BorderBrush="#3B82F6"/>
                                        <TextBox Name="txtNewCustomModel" Background="#0B1120" Foreground="#F8FAFC" BorderBrush="#273549" Padding="8,4"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 3. Live Output Log Console -->
        <Border Grid.Row="3" Background="{StaticResource BgConsole}" CornerRadius="6" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource BgSurface}" Padding="10,5" CornerRadius="6,6,0,0" BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#4ADE80" Margin="0,0,8,0"/>
                            <TextBlock Text="LIVE EXECUTION LOG" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox Name="cmbLogFilter" Width="115" FontSize="11" SelectedIndex="0">
                                <ComboBoxItem Content="All Logs"/>
                                <ComboBoxItem Content="OK / DONE"/>
                                <ComboBoxItem Content="DRY RUN"/>
                                <ComboBoxItem Content="ERRORS"/>
                                <ComboBoxItem Content="SKIPPED"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="btnCopySummary" Content="Copy Log" FontSize="10.5" Padding="8,3" Margin="0,0,6,0"/>
                            <Button Name="btnViewHtmlReport" Content="HTML Report" FontSize="10.5" Padding="8,3" Margin="0,0,6,0" Background="#0284C7" BorderBrush="#38BDF8"/>
                            <Button Name="btnExportJson" Content="Export JSON" FontSize="10.5" Padding="8,3" Margin="0,0,6,0"/>
                            <Button Name="btnViewCurrentLog" Content="View Log File" FontSize="10.5" Padding="8,3" Margin="0,0,6,0"/>
                            <Button Name="btnOpenLogsFolder" Content="Open Logs Folder" FontSize="10.5" Padding="8,3" Margin="0,0,6,0"/>
                            <Button Name="btnClearLog" Content="Clear Console" FontSize="10.5" Padding="8,3"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBox Name="txtLog" Grid.Row="1" Background="{StaticResource BgConsole}" Foreground="#A7F3D0"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0" Padding="10,8" AcceptsReturn="True" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- 4. Bottom Action Bar & Progress -->
        <Border Grid.Row="4" Background="{StaticResource BgSurface}" CornerRadius="8" Padding="14,10" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Name="pbProgress" Grid.Row="0" Height="5" Minimum="0" Maximum="100" Value="0"
                             Background="#0B1120" Foreground="#38BDF8" BorderThickness="0" Margin="0,0,0,10"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="lblStatus" Text="Ready. Click 'SCAN (DRY RUN)' to preview space or 'RUN SELECTED CLEANUP'."
                                   Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12.5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="Space Freed / Recoverable: " Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Name="lblFreed" Text="0.00 MB" Foreground="#4ADE80" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="  |  Operations: " Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Name="lblCleaned" Text="0" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Name="btnScan" Grid.Column="1" Content="SCAN (DRY RUN)"
                            Background="#0284C7" BorderBrush="#38BDF8" Foreground="White"
                            FontSize="12.5" FontWeight="Bold" Padding="16,9" Margin="0,0,8,0"/>

                    <Button Name="btnRun" Grid.Column="2" Content="RUN SELECTED CLEANUP"
                            Background="#16A34A" BorderBrush="#22C55E" Foreground="White"
                            FontSize="12.5" FontWeight="Bold" Padding="18,9" Margin="0,0,8,0"/>

                    <Button Name="btnCancel" Grid.Column="3" Content="Cancel" IsEnabled="False"
                            Background="#DC2626" BorderBrush="#EF4444" Foreground="White"
                            FontSize="12.5" FontWeight="Bold" Padding="14,9" Margin="0,0,8,0"/>

                    <Button Name="btnExit" Grid.Column="4" Content="Close"
                            Background="#1E293B" BorderBrush="#334155" Foreground="#CBD5E1"
                            FontSize="12.5" Padding="14,9"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
